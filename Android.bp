prebuilt_etc {
    name: "init_vendor_dlkm",
    src: "proprietary/vendor_dlkm/lib/modules/init.insmod.cfg",
    vendor: true,
    sub_dir: "lib/modules",
    owner: "realme",
}

// =============================================
// Module Loading Optimization
// =============================================

genrule {
    name: "generate_combined_modules_load",
    cmd: "grep -h -v ^# $(location proprietary/vendor_dlkm/lib/modules/modules.load) $(location proprietary/vendor_dlkm/lib/modules/modules.load.cali) > $(out)",
    srcs: [
        "proprietary/vendor_dlkm/lib/modules/modules.load",
        "proprietary/vendor_dlkm/lib/modules/modules.load.cali",
    ],
    out: ["modules.load.combined"],
    vendor: true,
}


// =============================================
// SELinux Configuration
// =============================================

prebuilt_etc {
    name: "vendor_dlkm_file_contexts",
    src: "sepolicy/vendor_dlkm/file_contexts",
    vendor: true,
    sub_dir: "etc/selinux",
    owner: "realme",
}

// =============================================
// vintf  Configuration
// =============================================

// All fragment XMLs in manifest/ directory
prebuilt_etc {
    name: "realme_vintf_fragments",
    srcs: ["proprietary/vendor-manifest/manifest/*.xml"],
    sub_dir: "vintf/manifest",
}

// Single main manifest
prebuilt_etc_xml {
    name: "realme_vintf_manifest",
    src: "proprietary/vendor-manifest/manifest.xml",
    sub_dir: "vintf",
}

// Single compatibility matrix
prebuilt_etc_xml {
    name: "realme_vintf_matrix",
    src: "proprietary/vendor-manifest/compatibility_matrix.xml",
    sub_dir: "vintf",
}

