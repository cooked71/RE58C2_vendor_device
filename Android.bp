    multilib: {
        lib32: {
            srcs: ["proprietary/lib/vendor.nxp.nxpnfclegacy@1.0.so"],
        },
        lib64: {
            srcs: ["proprietary/lib64/vendor.nxp.nxpnfclegacy@1.0.so"],
        },
    },
 shared_libs: [
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
