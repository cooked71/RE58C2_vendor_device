// =============================================
// Prebuilt APKs
// =============================================

android_app_import {
    name: "SoterService",
    owner: "realme",
    apk: "proprietary/system_ext/app/SoterService/SoterService.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    system_ext_specific: true,
}

