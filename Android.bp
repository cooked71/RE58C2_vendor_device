// License
// =============================================

license {
    name: "realme-proprietary-license",
    license_kinds: ["proprietary"],
    license_text: ["licenses/realme_proprietary_license.txt"],
    visibility: ["//vendor/realme/RE58C2:__subpackages__"],
}